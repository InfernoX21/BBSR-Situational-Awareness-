# ARKA C2 Command Server Environment Variables

# Server Port
PORT=3000

# Environment Mode: set to 'true' to enable demo fixtures with SEED/SIMULATED labels.
# In production (USE_DEMO_DATA=false or unset), unintegrated operational feeds display UNAVAILABLE states.
USE_DEMO_DATA=false

# Google Gemini API Key for AI Fusion & Autonomous Analysis
GEMINI_API_KEY=""

# Telegram Bot Token for Emergency Alert Broadcast (@Arkacmd_bot)
TELEGRAM_BOT_TOKEN=""

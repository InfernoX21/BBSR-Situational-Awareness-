# ARKA environment configuration
#
# Copy to `.env` and fill in the values you have. Every key below is read
# SERVER-SIDE ONLY, except the two VITE_* keys, which are compiled into the
# browser bundle and must therefore never hold a credential.
#
# ARKA starts and runs with none of these set. Endpoints whose provider is not
# configured report an honest UNAVAILABLE state instead of substituting values.

# ---------------------------------------------------------------------------
# Data honesty
# ---------------------------------------------------------------------------

# USE_DEMO_DATA: allows committed demo fixtures to be served, clearly labelled
# SEED or SIMULATED in the UI. MUST stay false in production — it is ignored
# entirely when NODE_ENV=production. Leave unset for the safe default (false).
USE_DEMO_DATA=false

# VITE_USE_DEMO_DATA: the same switch for the browser bundle, for local UI work
# without a server. Compiled into client JavaScript, so never put a secret in a
# VITE_* variable. Defaults to false.
VITE_USE_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Keyless providers (no configuration required)
# ---------------------------------------------------------------------------
# Weather, air quality and river discharge come from Open-Meteo (CC-BY 4.0) and
# airspace from the OpenSky Network. Both are keyless for non-commercial use and
# need no entry here. A municipal production deployment should confirm licensing
# with each provider and register for a quota.

# ADVISORY_RSS_FEEDS: comma-separated RSS URLs for the news/advisory panel.
# Defaults to a Google News query for Bhubaneswar. Google News is a media
# aggregator, NOT an official advisory channel, and is labelled as such.
# Point this at publisher feeds you have confirmed permit polling.
# ADVISORY_RSS_FEEDS=https://news.google.com/rss/search?q=Bhubaneswar+Odisha&hl=en-IN&gl=IN&ceid=IN:en

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: enables the AI intelligence-fusion panel. Without it the panel
# reports that no model is configured; it never returns a fabricated assessment.
# GEMINI_API_KEY=

# GEMINI_MODEL: model id to call. Configurable because model availability
# changes; an unavailable id surfaces as a provider error, not a fake result.
# GEMINI_MODEL=gemini-2.5-flash

# SADAKSH_AI_URL: local YOLO/ByteTrack inference service for camera analysis.
# When unreachable, camera-AI endpoints report UNAVAILABLE — no synthetic
# detections, tracks, FPS or latency figures are produced.
# SADAKSH_AI_URL=http://127.0.0.1:8008

# TELEGRAM_BOT_TOKEN: companion alert bot. Absent token ⇒ Telegram endpoints
# report not-configured; they do not report a successful send.
# TELEGRAM_BOT_TOKEN=

# ARKA_ADMIN_TOKEN: shared secret required by state-changing admin endpoints
# (such as installing a Telegram token at runtime). If unset, those endpoints
# are disabled rather than left open.
# ARKA_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Not yet integrated — documented so the gap is explicit
# ---------------------------------------------------------------------------

# DATA_GOV_IN_API_KEY: registered data.gov.in key for the CPCB real-time AQI
# resource. Until this exists, air quality is a Copernicus CAMS model estimate
# (~45 km grid) and is labelled "modelled", not a CPCB ground-station reading.
# The resource rejects unauthenticated automated requests with HTTP 403.
# DATA_GOV_IN_API_KEY=

# APP_URL: public URL this instance is hosted at, for self-referential links.
# APP_URL=
